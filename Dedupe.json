      "parameters": {
        "jsCode": "const seenEmails = new Set();\nconst duplicates = [];\n\nfor (const item of items) {\n\n    const email = String(item.json[\"Email\"] || \"\")\n        .trim()\n        .toLowerCase();\n\n    // Ignore blank emails\n    if (!email) continue;\n\n    if (seenEmails.has(email)) {\n\n        duplicates.push({\n            json: {\n                row_number: item.json.row_number,\n                email: email,\n                leadId: item.json[\"Lead ID\"],\n                fullName: item.json[\"Full Name\"]\n            }\n        });\n\n    } else {\n\n        seenEmails.add(email);\n\n    }\n}\n\nduplicates.sort((a, b) => b.json.row_number - a.json.row_number);\n\nreturn duplicates;"
      },
